+    def set_opacity(self, name: str, opacity: float):
+        """Apply primvars:displayOpacity to every instance prim under name.
+
+        USD-only helper used by callers that need translucent overlays
+        (e.g. ghost robot at a target pose). Renderers that honor
+        displayOpacity (Blender, Isaac, USDView) will draw the prims
+        at the requested alpha; others ignore it.
+        """
+        base_path = self._get_path(name)
+        base_prim = self.stage.GetPrimAtPath(base_path)
+        if not base_prim:
+            return
+        for prim in Usd.PrimRange(base_prim):
+            if not prim.IsValid() or prim == base_prim:
+                continue
+            if not UsdGeom.Imageable(prim):
+                continue
+            primvars_api = UsdGeom.PrimvarsAPI(prim)
+            opacity_pv = primvars_api.GetPrimvar("displayOpacity")
+            if not opacity_pv:
+                opacity_pv = primvars_api.CreatePrimvar(
+                    "displayOpacity",
+                    Sdf.ValueTypeNames.FloatArray,
+                    UsdGeom.Tokens.constant,
+                )
+            opacity_pv.Set([float(opacity)])
+
